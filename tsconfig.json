{
  "compilerOptions": {
    "target": "ES2022", "module": "preserve", "moduleResolution": "bundler",
    "experimentalDecorators": true, "useDefineForClassFields": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": true, "checkJs": false, "strict": false,
    "skipLibCheck": true, "esModuleInterop": true,
    "allowSyntheticDefaultImports": true, "isolatedModules": true,
    "types": [], "outDir": "./out-tsc"
  },
  "angularCompilerOptions": { "strictInjectionParameters": true, "strictInputAccessModifiers": true, "strictTemplates": true }
}
